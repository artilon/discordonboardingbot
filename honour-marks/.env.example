# ── Required ────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications -> your app -> Bot
HM_BOT_TOKEN=
HM_CLIENT_ID=

# Supabase — SAME project as Heimdall, so quest XP can reach the rank ladder.
# Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Register slash commands to one guild during development so they appear
# instantly instead of up to an hour. Leave blank for global registration.
HM_DEV_GUILD_ID=

# Pre-existing channels/roles. Leave blank and `/setup auto` will create them.
# If you set them, `/setup manual` binds to them instead.
HM_CLAIM_CHANNEL_ID=
HM_GUIDE_CHANNEL_ID=
HM_QUESTS_CHANNEL_ID=
HM_SHOP_CHANNEL_ID=
HM_DATABASE_CHANNEL_ID=
HM_STAFF_CHANNEL_ID=
HM_LOG_CHANNEL_ID=
HM_STAFF_ROLE_ID=

# Honour Marks role handed out by the Claim Role button.
# Defaults to 1565209304628338728 if unset.
HM_ROLE_ID=

# Role that can see #hm-role (the claim channel).
# Defaults to 1546403975656505354 if unset.
HM_CLAN_MEMBER_ROLE_ID=

# The ONLY Discord user who can see #hm-log. Leave blank and it defaults to
# whoever runs /setup.
HM_LOG_USER_ID=

# Extra roles that keep access to every Honour Marks channel (comma separated).
HM_MANAGE_ROLE_IDS=
